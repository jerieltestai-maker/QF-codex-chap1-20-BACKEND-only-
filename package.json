{
  "name": "quotefix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --import tsx apps/api/src/main.ts",
    "db:migrate": "tsx tools/database.ts migrate",
    "db:fixtures": "tsx tools/database.ts fixtures",
    "release:check": "tsx tools/release-check.ts",
    "mobile:typecheck": "pnpm --filter @quotefix/mobile typecheck",
    "mobile:export": "pnpm --filter @quotefix/mobile export",
    "typecheck": "tsc --noEmit && tsx tools/check-web.ts",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "build": "tsc"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.7.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
