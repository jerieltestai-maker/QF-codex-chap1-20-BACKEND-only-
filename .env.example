APP_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
IDENTITY_ADAPTER=local
DATABASE_ADAPTER=pglite
DATABASE_PATH=work/development-db
# Optional full path to an installed ClamAV clamscan executable. Missing/unhealthy scanner leaves uploads processing.
# CLAMSCAN_PATH=C:/Program Files/ClamAV/clamscan.exe
# For a PostgreSQL server use DATABASE_ADAPTER=postgres and a dedicated database:
# DATABASE_URL=postgresql://quotefix:local-only@127.0.0.1:5432/quotefix_development
LOCAL_ACCOUNT_HELPER=true
# Advice stays local until explicitly enabled with a server-only key.
ADVICE_PROVIDER=local
GEMINI_MODEL=gemini-3.5-flash-lite
# Set via tools/setup-gemini.ps1, or your own server secret environment.
# GEMINI_API_KEY_FILE=work/secrets/gemini-api-key
